PORT=5000
JWT_SECRET=change_this_secret_in_production

# CORS Origin (for Vercel frontend domain, e.g. https://figureverse.vercel.app or * for all)
CORS_ORIGIN=*

# PostgreSQL Database Configuration
# Option A: Connection URL (Recommended for Vercel Postgres / Neon / Supabase / Railway)
# DATABASE_URL=postgresql://user:password@host:5432/figure_verse_db?sslmode=require
# POSTGRES_URL=postgresql://user:password@host:5432/figure_verse_db?sslmode=require

# Option B: Discrete Host/Port/User parameters
USE_POSTGRES=true
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=figure_verse_db

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
