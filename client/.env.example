# Figure Verse Frontend Environment Variables (Vite)
# -----------------------------------------------------------------------------
# 1. If deploying Frontend and Backend together (or running locally with Vite proxy):
#    Leave VITE_API_BASE_URL=/api
# 2. If deploying Backend as a separate Vercel project:
#    Set VITE_API_BASE_URL=https://your-figureverse-backend.vercel.app/api
VITE_API_BASE_URL=/api

# Optional public Razorpay Key ID for client-side checkout display
VITE_RAZORPAY_KEY_ID=rzp_test_figureverse_demo

# Public Storefront Title
VITE_APP_NAME=Figure Verse
